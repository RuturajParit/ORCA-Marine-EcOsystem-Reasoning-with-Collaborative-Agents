# NVIDIA NIM — configure at least one key/model pair to enable LLM agents.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_1_KEY=your_nvidia_nim_api_key
MODEL_1=nvidia/nemotron-3-ultra-550b-a55b

# Optional additional models used for failover. Add matching key/model pairs.
# NVIDIA_NIM_2_KEY=your_second_nvidia_nim_api_key
# MODEL_2=openai/gpt-oss-20b
# NVIDIA_NIM_3_KEY=your_third_nvidia_nim_api_key
# MODEL_3=z-ai/glm-5.3-flash

# Copernicus Marine — required for salinity, chlorophyll-a, pH, oxygen and biomass layers.
# Create an account: https://data.marine.copernicus.eu/
CMEMS_USERNAME=your_cmems_username
CMEMS_PASSWORD=your_cmems_password

# Optional dataset overrides if Copernicus changes a product identifier.
# CMEMS_DS_PH=cmems_mod_glo_bgc-car_anfc_0.25deg_P1D-m
# CMEMS_VAR_PH=ph

# Comma-separated frontend origins. Keep '*' for local development only.
CORS_ORIGINS=*
